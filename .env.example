DATABASE_URL=postgresql://prtracker:prtracker@localhost:5432/prtracker

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_ADMIN_USER_ID=U12345678

WEBHOOK_SECRET=your-webhook-secret

PORT=3000

# Sign in with Slack (dashboard auth) — Basic Information → App Credentials
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=your-client-secret
SLACK_TEAM_ID=T12345678
# SESSION_SECRET: paste the output of `openssl rand -hex 32` (a literal value; changing it signs everyone out)
SESSION_SECRET=replace-with-a-long-random-string
SESSION_DAYS=30
PUBLIC_URL=https://pr.torbust.work

# AI code review (dashboard "Request AI review" button). Unset AI_REVIEW_REPO_PATH to disable.
# Scoped to a single repo — the button only appears on PRs whose repositorySlug matches
# AI_REVIEW_REPOSITORY_SLUG below (case-insensitively; Bitbucket webhooks send the repo's
# display name, which may not match its URL slug's casing). PRs from any other tracked repo
# never show it.
# Absolute path to a checkout of the reviewed repo (the review runs from it and reads its
# skills / CLAUDE.md files). docker-compose mounts this path into the app container at the same location.
AI_REVIEW_REPO_PATH=/home/you/src/shiplink
AI_REVIEW_REPOSITORY_SLUG=shiplink
# The review command itself is the Claude Code plugin in ai-review/code-review-bitbucket of this repo.
# AI_REVIEW_PLUGIN_PATH=ai-review/code-review-bitbucket
# AI_REVIEW_COMMAND=/code-review-bitbucket:code-review
# AI_REVIEW_CLAUDE_BIN=claude
# Command that starts the Bitbucket MCP server.
# AI_REVIEW_BITBUCKET_MCP_COMMAND=npx -y @aashari/mcp-server-atlassian-bitbucket
# Credentials the MCP server uses. The token needs read:repository, read:pullrequest AND write:pullrequest
# (it posts the review comment). Falls back to BITBUCKET_EMAIL / BITBUCKET_API_TOKEN when unset.
# AI_REVIEW_BITBUCKET_EMAIL=you@example.com
# AI_REVIEW_BITBUCKET_API_TOKEN=ATATT3...
# AI_REVIEW_TIMEOUT_MINUTES=30
# Host uid/gid the app container runs as, so it can use the mounted ~/.claude credentials (default 1000).
# APP_UID=1000
# APP_GID=1000
